{
  "name": "@codaryn/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "test:integration": "pnpm run build && node --env-file-if-exists=../../.env --test dist/workspaces.integration.test.js",
    "verify": "tsx src/verify.ts",
    "test": "pnpm build && node --test dist/client.test.js dist/column-type.test.js dist/diagrams.test.js",
    "test:recovery": "tsx src/recovery-drill.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
